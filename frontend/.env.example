# StudyAI Frontend Environment Variables

# Base URL for Vite deployment (e.g. /STUDY_AI-/ for GitHub Pages, or / for local root)
VITE_BASE_URL=/STUDY_AI-/

# Optional: StudyAI Backend API Base URL
# If empty, frontend automatically runs in Offline/Local persistence mode without network requests.
# When running full-stack locally:
# VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_API_BASE_URL=
