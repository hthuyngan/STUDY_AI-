# StudyAI ASP.NET Core Backend Environment Variables (Optional overrides)

ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=Server=.\\SQLEXPRESS;Database=StudyAIDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True
Jwt__SecretKey=replace_with_a_secure_random_key_with_at_least_32_characters!
Jwt__Issuer=StudyAI.Api
Jwt__Audience=StudyAI.Client
Jwt__AccessTokenExpireMinutes=30
Jwt__RefreshTokenExpireDays=7
ADMIN_BOOTSTRAP_PASSWORD=
