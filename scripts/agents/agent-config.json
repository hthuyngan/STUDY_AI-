{
  "schemaVersion": "1.1.0",
  "project": "STUDY_AI-",
  "orchestrator": {
    "platform": "Antigravity",
    "recommendedModel": "Gemini 4 Hydrogen (Medium)",
    "canModifyAppCode": false,
    "nativeSubagentModelEnum": ["inherit", "flash_lite", "flash", "pro"],
    "defaultWorkerModel": "inherit",
    "note": "Single-session Hydrogen Medium topology: Orchestrator and implementation-worker (Model: inherit) both run on Gemini 4 Hydrogen (Medium). Codex CLI handles read-only planning and review."
  },
  "implementationWorker": {
    "platform": "Antigravity",
    "recommendedModel": "Gemini 4 Hydrogen (Medium)",
    "canModifyAppCode": true,
    "maxConcurrentWorkers": 1
  },
  "reviewer": {
    "platform": "Codex Local CLI",
    "model": "gpt-5.6-sol",
    "sandbox": "read-only",
    "ignoreUserConfig": true,
    "disablePlugins": true,
    "reasoning": {
      "planning": "medium",
      "initialReview": "medium",
      "simpleReReview": "low",
      "complexSecurityReview": "medium"
    },
    "timeoutSeconds": 1200,
    "maxAutomaticReviewRounds": 3,
    "maxConcurrentReviews": 1
  },
  "taskRouting": {
    "defaultRoute": "STANDARD",
    "ECO": {
      "agents": "1 Anti Medium",
      "requirePlan": false,
      "requireCodexReview": false,
      "canBypassSecurityOrDbGates": false,
      "useWhen": "Trivial docs/formatting/local-only edits with zero security, DB, or API impact"
    },
    "STANDARD": {
      "agents": "1 Anti Medium + Codex",
      "requirePlan": false,
      "requireTargetedTests": true,
      "requireCodexReview": true,
      "canBypassSecurityOrDbGates": false,
      "useWhen": "Default for normal coding tasks (CRUD, API, UI, bugfixes) without architectural/DB risk"
    },
    "ADVANCED": {
      "agents": "2 Anti Medium (Orchestrator + Worker) + Codex",
      "requirePlan": true,
      "requireFullAcceptanceGates": true,
      "requireIndependentReview": true,
      "requireUserApproval": true,
      "canBypassSecurityOrDbGates": false,
      "useWhen": "Large phases, security, RBAC, database/migrations, concurrency, or architecture changes"
    }
  },
  "reviewCache": {
    "enabled": true,
    "ttlHours": 24,
    "invalidateOn": ["base_sha", "head_sha", "review_mode", "scope", "policy_hash"]
  },
  "tokenOptimization": {
    "maxDiffChars": 60000,
    "excludeDiffPaths": [
      "node_modules",
      "bin",
      "obj",
      "dist",
      "package-lock.json",
      "bun.lockb"
    ],
    "maxLogErrorLines": 25,
    "usageMetricsEnabled": true
  },
  "policies": {
    "autoMerge": false,
    "autoPhaseAdvance": false,
    "persistentDatabaseWrites": false,
    "allowDirtyWorktreeForReview": false,
    "requireImmutableSnapshot": true,
    "protectedDatabases": [
      "StudyAIDb",
      "StudyAIDb_E2E"
    ],
    "allowedTestDatabasePrefix": "StudyAIDb_Clean_",
    "protectedBranches": [
      "main",
      "feature/backend-redesign-modular-monolith",
      "feature/p02-multi-subject-curriculum-lifecycle"
    ]
  },
  "mcpAllocation": {
    "antigravity": [
      "serena",
      "context7",
      "chrome_devtools",
      "playwright",
      "microsoft-learn"
    ],
    "codexReviewer": []
  }
}
